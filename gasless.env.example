# Gasless sponsorship service (cmd/gasless). Copy to gasless.env for local dev
# (gitignored by the *.env rule). This is a SEPARATE service from the deposit
# bridge: it must never contain POOL_* keys or RECOVERY_ADDRESS — it refuses
# to start if it sees them.

# ── Network ───────────────────────────────────────────────────────────────────
NETWORK=testnet
RPC_URL=https://soroban-testnet.stellar.org

# ── FeeForwarder contract ─────────────────────────────────────────────────────
# Testnet deployment recorded in latch-contracts docs/BUILD.md.
FEE_FORWARDER_CONTRACT_ID=CB6KFDFN7CXIOSBOEXABOX6KPRK4X6VMPSDWCGYP564JXGN2LIH2QPWI

# ── Keys (see docs/gasless-keys.md) ───────────────────────────────────────────
# Executor: holds the FeeForwarder `executor` role (granted by the contract
# admin) and signs the relayer's authorization for every forward(). Needs only
# its base reserve. The service checks the role at startup and refuses to run
# without it.
EXECUTOR_ADDRESS=G...
EXECUTOR_PRIVATE_KEY=S...

# Funder: pays every sponsored transaction's XLM fee via fee-bump. Holds the
# float. Sponsorship stops when it drops below FUNDER_MIN_XLM.
FUNDER_ADDRESS=G...
FUNDER_PRIVATE_KEY=S...
# FUNDER_MIN_XLM=50

# Channels: powerless transaction-source accounts, one in-flight sponsored tx
# each (throughput ≈ CHANNEL_COUNT per ledger). Derived from this seed at
# SEP-0005 paths m/44'/148'/i' — create them with `make channels`.
# Generate the seed with: openssl rand -hex 32
CHANNEL_SEED=
CHANNEL_COUNT=10
# CHANNEL_MIN_XLM=1
# BALANCE_CHECK_SECONDS=60

# ── Sponsorship (POST /gasless/submit) ────────────────────────────────────────
# The only calls Latch pays for: a new wallet's setup. CONTRACT:function, where
# CONTRACT is a C-address or "wallet" (the wallet the request is for). Every
# other transaction is paid by the user (forward mode, not built yet).
SPONSORED_CALLS=<FACTORY_CONTRACT_ID>:create_account,wallet:add_context_rule,wallet:add_signer
# Caps (defaults shown). Per wallet, over its lifetime; daily is all wallets, rolling 24h.
# SPONSOR_MAX_TX_PER_WALLET=5
# SPONSOR_MAX_XLM_PER_WALLET=2
# SPONSOR_MAX_XLM_PER_DAY=200
# Highest per-operation inclusion fee bid, in stroops, including fee retries.
# MAX_INCLUSION_FEE_STROOPS=20000
# How long a submit waits for the outcome before answering 202 (max 25).
# SPONSOR_SYNC_WAIT_SECONDS=20

# ── Forward mode (user pays in XLM, or USDC if no XLM) ────────────────────────
# FORWARD_ENABLED=true
# The USDC SAC users may pay fees in; unset = XLM only. XLM's SAC is derived.
# USDC_CONTRACT_ID=
# Added to the network cost before converting (resource drift, price moves).
# FEE_MARGIN_BPS=2500
# How long the executor's forward() signature stays valid.
# EXECUTOR_AUTH_LEDGERS=60
# XLM/USD for USDC fees. Testnet has no market price: set XLM_USD_PRICE there.
# Mainnet reads StellarExpert (STELLAR_EXPERT_API_KEY for production quotas).
# XLM_USD_PRICE=
# STELLAR_EXPERT_API_KEY=

# ── Service ───────────────────────────────────────────────────────────────────
# Its own database (not the deposit bridge's).
DATABASE_URL=postgres://user:password@localhost:5432/latch_gasless?sslmode=disable
PORT=4001
# Its own API key, distinct from the deposit bridge's. openssl rand -hex 32
RELAYER_API_KEY=
# INSTANCE_ID defaults to hostname-pid; shows which instance holds a channel lease.

# Capacity knobs shared with the deposit service (defaults shown):
# DB_MAX_CONNS=20  DB_MIN_CONNS=2  MAX_INFLIGHT_REQUESTS=500
# RATE_LIMIT_RPS=100  RATE_LIMIT_BURST=300  RPC_TIMEOUT_MS=15000
# SHUTDOWN_DRAIN_SECONDS=30
