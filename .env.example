# Network
NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
RPC_URL=https://soroban-testnet.stellar.org

# Pooled / Hot Account (monitored by the watcher)
POOL_ADDRESS_1=G...
POOL_PRIVATE_KEY_1=S...

# Depositor (test account used to send deposits)
DEPOSITOR_ADDRESS=G...
DEPOSITOR_PRIVATE_KEY=S...

# Recovery address (for unknown/missing memos)
RECOVERY_ADDRESS=G...

# Database
DATABASE_URL=postgres://user:pass@localhost:5432/latch_relayer

# Server
PORT=4000
