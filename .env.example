# Copy this file to .env and fill in the values for local development.
# Never commit .env — it is gitignored.

# ── Stellar Network ───────────────────────────────────────────────────────────

# Which network to connect to. Determines the network passphrase automatically.
# Options: testnet (default), mainnet
NETWORK=testnet

# Horizon REST API — used to watch for inbound payments via SSE.
# Defaults to the public testnet endpoint.
HORIZON_URL=https://horizon-testnet.stellar.org

# Stellar RPC — used to simulate and submit Soroban transactions.
# Defaults to the public testnet endpoint.
RPC_URL=https://soroban-testnet.stellar.org

# ── Pool Accounts ─────────────────────────────────────────────────────────────

# The relayer watches one Horizon SSE stream per pool account.
# Add more accounts by incrementing the index (POOL_ADDRESS_2, POOL_PRIVATE_KEY_2, etc.)
# The address and private key must match — the relayer validates this at startup.
# Required: at least POOL_ADDRESS_1 + POOL_PRIVATE_KEY_1.
POOL_ADDRESS_1=G...
POOL_PRIVATE_KEY_1=S...

# ── Recovery ──────────────────────────────────────────────────────────────────

# G-address that receives deposits with no matching intent (missing or unknown memo).
# Use a separate account you control — not a pool address.
# Required.
RECOVERY_ADDRESS=G...

# ── Database ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string (pgx/v5 format).
# Required.
DATABASE_URL=postgres://user:password@localhost:5432/latch_relayer?sslmode=disable

# ── HTTP Server ───────────────────────────────────────────────────────────────

# Port the relayer HTTP server listens on. Defaults to 4000.
PORT=4000

# Shared secret every caller must send as `Authorization: Bearer <key>`.
# Only /health is exempt. latch-api is the intended caller — this is a
# service-to-service secret, not a user token.
# Required, minimum 32 characters. Generate with: openssl rand -hex 32
RELAYER_API_KEY=
