# Live E2E tests (scripts/e2e_live). Copy to e2e.env (gitignored by *.env).
# Values here win over .env; anything unset falls back to .env, then defaults.

# ── Targets ───────────────────────────────────────────────────────────────────
LATCH_API_URL=https://latch-api-4cvn.onrender.com
RELAYER_URL=https://latch-relayer-zy93.onrender.com

# ── Login ─────────────────────────────────────────────────────────────────────
# Deposit endpoints only accept email-login users. The first run emails a code
# and asks for it (or, without a terminal, exits so you can rerun with
# E2E_OTP=<code>). The session is then kept in .e2e-session.env for 30 days.
E2E_EMAIL=
# Optional second user: enables the cross-user status check in `authz`.
# E2E_EMAIL_2=

# ── Funds ─────────────────────────────────────────────────────────────────────
# Testnet account that sends the deposits. Falls back to DEPOSITOR_PRIVATE_KEY
# from .env; if neither is set, a fresh friendbot-funded account is used.
# E2E_DEPOSITOR_SEED=S...
# Whole XLM per deposit; a random 7-decimal fraction is added so every deposit
# can be matched on chain.
# E2E_AMOUNT=2

# ── Optional checks ───────────────────────────────────────────────────────────
# Read-only: confirms latch-api is wired to RELAYER_URL. Never used to create
# anything. Falls back to RELAYER_API_KEY from .env.
# RELAYER_API_KEY=
# Where sweeps are expected to land (a mismatch is reported, not failed).
# RECOVERY_ADDRESS=G...
